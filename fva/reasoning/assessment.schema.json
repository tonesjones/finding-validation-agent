{
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "confidence"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "stance", "suggested_reason_code", "citations"],
        "properties": {
          "statement": {"type": "string"},
          "stance": {"type": "string", "enum": ["supports", "refutes", "non_security", "neutral"]},
          "suggested_reason_code": {"type": ["string", "null"]},
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line", "quote"],
              "properties": {
                "path": {"type": "string"},
                "line": {"type": "integer"},
                "quote": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
  }
}
